# Database connection (PostgreSQL 16)
DATABASE_URL=postgresql://quoteflow:quoteflow@localhost:5433/quoteflow
POSTGRES_PORT=5433
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
PORT=3001

# Keep-Alive settings (auto-detected on Render via RENDER_EXTERNAL_URL)
# KEEP_ALIVE_URL=https://quoteflow-api.onrender.com
# KEEP_ALIVE_INTERVAL_MS=30000

# Frontend environment variable (set on Vercel)
# VITE_API_BASE_URL=https://quoteflow-api.onrender.com
# VITE_DEMO_MODE=false

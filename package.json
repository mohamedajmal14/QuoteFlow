{
  "name": "quote-flow-react-node",
  "version": "1.0.0",
  "private": true,
  "description": "A full stack quote pipeline workspace built with React, TypeScript, Node and Express.",
  "author": "Mohamed Ajmal - A curious developer working with real time projects",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev --workspace @quoteflow/api\" \"npm run dev --workspace @quoteflow/web\"",
    "build": "npm run build --workspace @quoteflow/api && npm run build --workspace @quoteflow/web",
    "lint": "npm run lint --workspace @quoteflow/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace @quoteflow/api",
    "test:web": "npm run test --workspace @quoteflow/web",
    "test:web:watch": "npm run test:watch --workspace @quoteflow/web",
    "test:e2e": "npm run test:e2e --workspace @quoteflow/web",
    "test:integration": "npm run test:integration --workspace @quoteflow/api",
    "db:migrate": "npm run db:migrate --workspace @quoteflow/api",
    "db:seed": "npm run db:seed --workspace @quoteflow/api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "start": "npm run start --workspace @quoteflow/api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
